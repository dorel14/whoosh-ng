{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "outDir": "./build",
    "rootDir": "."
  },
  "include": ["src", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": ["node_modules", "build"]
}
